  <tr>
    <!-- Muestra los emojis en tamaño grande -->
    <td><span style="font-size: 7rem"><?= $jugador1; ?></span></td>
    <td><span style="font-size: 7rem"><?= $jugador2; ?></span></td>
  </tr>

  <!-- Fila donde se indica el mensaje del resultado -->
  <tr>
    <th colspan="2"><?= $mensaje ?></th>
  </tr>
