<?php

// ------------------------------------------------------------
// DEFINICIÓN DE ICONOS EMOJI PARA EL JUEGO
// ------------------------------------------------------------
// PIEDRA (Puño derecho)
// PIEDRA2 (Puño izquierdo para el jugador 2)
// TIJERAS
// PAPEL
define ('PIEDRA',   "&#x1F91C;");
define ('PIEDRA2',  "&#x1F91B;");
define ('TIJERAS',  "&#x1F596;");
define ('PAPEL',    "&#x1F91A;" );

// ------------------------------------------------------------
// MENSAJES SEGÚN EL GANADOR: 0 → Empate, 1 → Gana J1, 2 → Gana J2
// ------------------------------------------------------------
$tmsg = [
          "¡Empate !",
          " Ha ganado el jugador 1",
          " Ha ganado el jugador 2"
        ];

/**
 * ------------------------------------------------------------
 * FUNCIÓN calcularGanador
 * ------------------------------------------------------------
 * Parámetros:
 *   - $valor1 → jugada del jugador 1 (PIEDRA, PAPEL o TIJERAS)
 *   - $valor2 → jugada del jugador 2
 * Resultado:
 *   - 0 → Empate
 *   - 1 → Gana jugador 1
 *   - 2 → Gana jugador 2
 * ------------------------------------------------------------
 */
function calcularGanador (String $valor1, String $valor2): int{
    
    $ganador = 0;  // Valor por defecto: empate

    // Si ambos jugadores sacan lo mismo → empate
    if ( $valor1 == $valor2 ) return $ganador;

    // Combinaciones ganadoras
    switch ($valor1){
        case PIEDRA:  
            // Piedra gana a tijeras, pierde contra papel
            $ganador = ( $valor2 == TIJERAS)?1:2; 
            break;

        case TIJERAS: 
            // Tijeras gana a papel, pierde contra piedra
            $ganador = ( $valor2 == PAPEL  )?1:2; 
            break;

        case PAPEL:   
            // Papel gana a piedra, pierde contra tijeras
            $ganador = ( $valor2 == PIEDRA )?1:2; 
            break;
    }
    return $ganador;
}

/**
 * ------------------------------------------------------------
 * FUNCIÓN obtenerFicha
 * ------------------------------------------------------------
 * Devuelve aleatoriamente una jugada:
 *   - PIEDRA
 *   - TIJERAS
 *   - PAPEL
 * ------------------------------------------------------------
 */
function obtenerFicha (){
  $valor = rand(0,2); // Número aleatorio entre 0 y 2

  switch ($valor){
    case 0: return PIEDRA;
    case 1: return TIJERAS;
    case 2: return PAPEL;
  }
}

// ------------------------------------------------------------
// GENERACIÓN DE LAS JUGADAS PARA CADA JUGADOR
// ------------------------------------------------------------
$jugador1 = obtenerFicha();   // Jugada del jugador 1
$jugador2 = obtenerFicha();   // Jugada del jugador 2

// Determina quién gana
$pos = calcularGanador($jugador1,$jugador2);

// Obtiene el mensaje correspondiente (empate, gana J1, gana J2)
$mensaje =  $tmsg[$pos]; 

// Si el jugador 2 sacó piedra, se usa el icono de la piedra izquierda
$jugador2 = ($jugador2 == PIEDRA)?PIEDRA2:$jugador2;

?>

